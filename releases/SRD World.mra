<misterromdescription>
    <!-- Super Real Darwin for MiSTer - Copyright (C) 2026 Eggsecutioner528. Licensed under the GNU GPL, version 2 or later. Provenance mark GDM-1c117d88b977 -->
    <name>Super Real Darwin (World)</name>
    <setname>srdarwin</setname>
    <rbf>SRD</rbf>
    <mameversion>0266</mameversion>
    <year>1987</year>
    <manufacturer>Data East Corporation</manufacturer>
    <category>Shooter</category>
    <players>2</players>
    <joystick>8-way</joystick>
    <rotation>vertical (ccw)</rotation>
    <buttons names="Button 1,Button 2,Start,Coin" default="A,B,Start,Select" />

    <!-- This MRA carries the Super Real Darwin (World) version of the game. The other version has its own MRA: load it to change version.
         ROM stream (see rtl/srd_loader.v): 0x000000 background tile ROM, 0x020000 sprite ROM, 0x050000 main CPU, character ROM, MCU ROM and sound ROM.
         The files come from srdarwin.zip (in the games folder, /media/fat/games/mame). -->

    <rom index="0" zip="srdarwin.zip" md5="none">
        <!-- background tile ROM: four banks of (dy_03.b4 chunk, dy_02.b5 chunk), 0x4000 bytes each -->
        <part zip="srdarwin.zip" name="dy_03.b4" crc="44f2a4f9" offset="0x0" length="0x4000" />
        <part zip="srdarwin.zip" name="dy_02.b5" crc="522d9a9e" offset="0x0" length="0x4000" />
        <part zip="srdarwin.zip" name="dy_03.b4" crc="44f2a4f9" offset="0x4000" length="0x4000" />
        <part zip="srdarwin.zip" name="dy_02.b5" crc="522d9a9e" offset="0x4000" length="0x4000" />
        <part zip="srdarwin.zip" name="dy_03.b4" crc="44f2a4f9" offset="0x8000" length="0x4000" />
        <part zip="srdarwin.zip" name="dy_02.b5" crc="522d9a9e" offset="0x8000" length="0x4000" />
        <part zip="srdarwin.zip" name="dy_03.b4" crc="44f2a4f9" offset="0xc000" length="0x4000" />
        <part zip="srdarwin.zip" name="dy_02.b5" crc="522d9a9e" offset="0xc000" length="0x4000" />
        <!-- sprite ROM, six files in MAME region order -->
        <part zip="srdarwin.zip" name="dy_07.h16" crc="97eaba60" />
        <part zip="srdarwin.zip" name="dy_06.h14" crc="c279541b" />
        <part zip="srdarwin.zip" name="dy_09.k13" crc="d30d1745" />
        <part zip="srdarwin.zip" name="dy_08.k11" crc="71d645fd" />
        <part zip="srdarwin.zip" name="dy_11.k16" crc="fd9ccc5b" />
        <part zip="srdarwin.zip" name="dy_10.k14" crc="88770ab8" />
        <!-- Super Real Darwin (World): dy_00 (banks 0-3), dy_01 (banks 4-5 and the fixed ROM), character ROM, i8751 MCU ROM, sound ROM -->
        <part zip="srdarwin.zip" name="dy_00.b16" crc="2bf6b461" />
        <part zip="srdarwin.zip" name="dy_01-e.b14" crc="176e9299" />
        <part zip="srdarwin.zip" name="dy_05.b6" crc="8780e8a3" />
        <part zip="srdarwin.zip" name="dy-e.d11" crc="11cd6ca4" />
        <part zip="srdarwin.zip" name="dy_04.d7" crc="2ae3591c" />
    </rom>
    <!-- one byte for the core: the version (selects the coin options of the OSD) -->
    <rom index="1"><part>00</part></rom>
</misterromdescription>
